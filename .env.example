# MongoDB — full Atlas connection string (must start with mongodb+srv:// or mongodb://)
# Do not wrap in quotes in Vercel. Example:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
#
# PERSISTENCE: Runs, builds, leaderboards, and user links live in MongoDB — not on the Vercel app.
# Redeploys do NOT wipe this data. Keep MONGODB_URI and MONGODB_DB_NAME stable across deploys.
# Changing either env var points the app at a different (possibly empty) database.
MONGODB_URI=
MONGODB_DB_NAME=destinytopnest

# Session JWT — use a long random string; JWT_SECRET is an alias
SESSION_SECRET=
JWT_SECRET=

# Site URL (production OAuth redirects)
NEXT_PUBLIC_BASE_URL=https://topnest.app

# Bungie API + OAuth (primary login)
DESTINY_API=
BUNGIE_API_KEY=
BUNGIE_OAUTH_CLIENT_ID=
BUNGIE_OAUTH_CLIENT_SECRET=
BUNGIE_OAUTH_REDIRECT_URI=https://topnest.app/api/destiny/auth/bungie/callback

# Primary owner allowlist (comma-separated Bungie names or handles).
# Defaults to Bulletbait604#0950 when unset. Only this account can grant/revoke other admins.
OWNER_USERNAMES=

# Optional — Google AI (future meta research / Gemini features; not required today)
# Aliases used elsewhere in the monorepo: GEMINI_API, GOOGLE_API_KEY
GOOGLE_API=
GEMINI_API=

# Optional cookie hardening in production
# SESSION_COOKIE_SECURE=true

# Monetary / physical season prizes (platform cards, cash, 3D prints).
# Bungie API terms require non-commercial use unless Bungie gives written permission.
# Leave unset or false. Prize-claim code stays in the app but is hidden and rejected.
# NEXT_PUBLIC_FIRETEAM_HQ_MONETARY_PRIZES=false

# Optional JSON array of weekly contract definitions. Invalid JSON falls back to the built-in set.
# FIRETEAM_HQ_WEEKLY_CONTRACTS_JSON=

# Optional Community Night Ops catalog. Invalid JSON or a missing value shows an empty schedule.
# Each event: id, title, hostName, startsAt, endsAt (ISO), optional activityName, kickUrl, twitchUrl (https only).
# FIRETEAM_HQ_NIGHT_OPS_JSON=[{"id":"ops-1","title":"Vow Night","hostName":"NestTV","startsAt":"2026-10-14T23:00:00.000Z","endsAt":"2026-10-15T02:00:00.000Z","activityName":"Vow of the Disciple","twitchUrl":"https://twitch.tv/nesttv","kickUrl":"https://kick.com/nesttv"}]

# Optional Discord bot. Leave unset and the site stays a no-op: routes return idle JSON and do not call Discord.
# DISCORD_BOT_TOKEN=
# DISCORD_PUBLIC_KEY=
# DISCORD_APPLICATION_ID=
# DISCORD_ANNOUNCE_CHANNEL_ID=
# After the token and application id are set, POST /api/discord/register (Bearer CRON_SECRET when that secret is set)
# to publish /passport, /clan, and /lfg. Point Discord's interactions endpoint at
# https://topnest.app/api/discord/interactions
# Announcements: POST /api/discord/announce

# Existing weekly cron auth. Required before Discord announce or command registration will run.
# Interactions stay public and are verified with DISCORD_PUBLIC_KEY instead.
# CRON_SECRET=

# Bungie HTTP 429s are retried once. The wait follows Retry-After and is capped at 2 seconds.
# A second 429 returns an error to the caller instead of looping. DESTINY_API (or BUNGIE_API_KEY) is required
# for live Bungie calls; profile and leaderboard reads that only use stored runs still render without it.
